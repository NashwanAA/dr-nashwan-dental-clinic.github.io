    <link rel="stylesheet" href="style.css">
    <link rel="icon" href="assets/logo/favicon.ico">

    <!-- MEDICAL SERVICE SCHEMA FOR DETAILED SEARCH RESULT RENDERING -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "MedicalWebPage",
        "name": "قائمة الخدمات الطبية والجراحية بمركز الدكتور نشوان الخولاني",
        "url": "https://nashwanaa.github.io/dr-nashwan-dental-clinic/services.html",
        "description": "دليل الخدمات الشامل لطب الأسنان وجراحة الفم والوجه والفكين والزراعات المتطورة ثلاثية الأبعاد بمدينة إب.",
        "mainEntity": {
            "@type": "MedicalClinic",
            "name": "مركز الدكتور نشوان عبد الوهاب الخولاني لطب الأسنان",
